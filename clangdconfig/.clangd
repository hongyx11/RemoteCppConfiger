# Defaults applied to every file
CompileFlags:
  CompilationDatabase: ./build
  Add:
    - "--no-cuda-version-check"
    # report all errors
    - "-ferror-limit=0"
  Remove:
    # strip CUDA fatbin args
    - "-Xfatbin*"
    # strip CUDA arch flags
    - "-gencode*"
    - "--generate-code*"
    # strip CUDA flags unknown to clang
    - "-ccbin*"
    - "--compiler-options*"
    - "--expt-extended-lambda"
    - "--expt-relaxed-constexpr"
    - "-forward-unknown-to-host-compiler"
    - "-Werror=cross-execution-space-call"
    - "--options-file"
    - "-Xcompiler=*"
    - "-Xcudafe"
    - "--diag-suppress=1650"
    - "--diag-suppress=128"
    - "-compress-all"
    - "--threads"
    - "-frerun-loop-opt"
    - "-fabi-compat-version=2"

Diagnostics:
  Suppress:
    - "pp_including_mainfile_in_preamble"
    - "builtin_definition"
    - "unused-includes"
    - "variadic_device_fn"
    - "attributes_not_allowed"

Hover:
  ShowAKA: No

InlayHints:
  Enabled: No

---

# C and C++ sources / headers
If:
  PathMatch: .*\.(c|h|cpp|hpp|cc|hh|cxx|hxx)$
CompileFlags:
  Compiler: g++
  Add:
    - "-x"
    - "c++-header"
    - "--std=c++17"

---

# CUDA sources / headers
If:
  PathMatch: .*\.cuh?$
CompileFlags:
  Compiler: /usr/local/cuda/bin/nvcc
  Add:
    - "--cuda-path=/usr/local/cuda"
    - "--cuda-gpu-arch=sm_90a"
    - "-I/usr/local/cuda/include"
    - "-xcuda"
    - "--std=c++17"
    - "-D__INTELLISENSE__"
    - "-D__CLANGD__"
    - "-DCUDA_12_0_SM90_FEATURES_SUPPORTED"
    - "-DCUTLASS_ARCH_MMA_SM90_SUPPORTED=1"
    - "-D_LIBCUDACXX_STD_VER=12"
    - "-D__CUDACC_VER_MAJOR__=12"
    - "-D__CUDACC_VER_MINOR__=3"
    - "-D__CUDA_ARCH__=900"
    - "-D__CUDA_ARCH_FEAT_SM90_ALL"
    - "-Wno-invalid-constexpr"
